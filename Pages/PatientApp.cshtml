<style>
    h1 {text-align: center;}
    h2 {text-align: center;}
    p {text-align: center;}
    .Appointments {
        align-items: center;
        margin: 0 auto;
        width: 80%;
        /* General Body Styling */
    body {
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 0;
        background-color: #f7f7f7;
    }

    /* Review Form Container */
    .review-card {
        background: #fff;
        border-radius: 10px;
        padding: 20px;
        width: 100%;
        max-width: 350px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        text-align: center;
        margin: 10px auto;
    }

    .review-card h2 {
        margin: 0 0 5px;
        font-size: 18px;
        color: #333;
    }

    .review-card .info {
        margin-bottom: 15px;
        color: #555;
        font-size: 14px;
    }

    .stars {
        display: flex;
        justify-content: center;
        gap: 5px;
        margin: 10px 0;
    }

    .star {
        width: 30px;
        height: 30px;
        background: url('star-outline.svg') no-repeat center;
        background-size: contain;
        cursor: pointer;
        transition: transform 0.2s ease;
    }

    .star:hover,
    .star.selected {
        background: url('star-filled.svg') no-repeat center;
        transform: scale(1.2);
    }

    .feedback {
        margin: 10px 0;
        color: #777;
    }

    .feedback textarea {
        width: 100%;
        padding: 10px;
        border: 1px solid #ddd;
        border-radius: 5px;
        resize: none;
        font-size: 14px;
    }

    .add-btn {
        margin-top: 10px;
        padding: 10px 20px;
        border: none;
        background: #007bff;
        color: #fff;
        border-radius: 5px;
        cursor: pointer;
        transition: background 0.3s ease;
        font-size: 14px;
    }

    .add-btn:hover {
        background: #0056b3;
    }

    .add-btn:disabled {
        background: #ccc;
        cursor: not-allowed;
    }

    /* Review Form Container (Hidden by Default) */
    .review-form-container {
        display: none;
        margin-top: 15px;
    }
    .star {
    font-size: 30px; /* Size of the star */
    color: #ccc; /* Color of empty stars */
    cursor: pointer;
    transition: color 0.3s ease, transform 0.2s ease; /* Hover effects */
            }

    .star.selected, .star:hover {
    color: gold; /* Color of selected or hovered stars */
    transform: scale(1.2); /* Slight enlargement on hover */
    }

    </style>

<div class="Appointments">
    <br>
    <div class="tabs">
        <button class="tab active" onclick="showSection('upcoming')">Upcoming</button>
        <button class="tab" onclick="showSection('pending')">Pending</button>
        <button class="tab" onclick="showSection('completed')">Completed</button>
        <button class="tab" onclick="showSection('canceled')">Canceled</button>
    </div>
    
    <!-- Upcoming Appointments -->
    <div id="upcoming" class="Appointment-section active">
        <h2>Today</h2>
        <br>
        <div class="Appointments-group">
            @foreach (var Appointment in Model.TodayDrAppointments)
            {
                <div class="Appointment-card">
                    <div class="Appointment-header">
                        <img src="default-user.png" alt="User Photo" class="user-photo" />
                        <span>@Appointment.Name</span>
                        <span class="status confirmed">@Appointment.Status</span>
                    </div>
                    <div class="Appointment-info">
                        <div>
                            <span class="icon">⏰</span> @Appointment.Time
                        </div>
                        <div>
                            <span class="icon">📅</span> @Appointment.Date
                        </div>
                    </div>
                    <div class="Appointment-actions">
                        <button class="btn cancel" style="display: block; margin: 0 auto;">Cancel</button>
                    </div>
                </div>
            }
        </div>
        <br>
        <h2>Tomorrow</h2>
        <br>
        <div class="Appointments-group">
            @foreach (var Appointment in Model.TomorrowDrAppointments)
            {
                <div class="Appointment-card">
                    <div class="Appointment-header">
                        <img src="default-user.png" alt="User Photo" class="user-photo" />
                        <span>@Appointment.Name</span>
                        <span class="status confirmed">@Appointment.Status</span>
                    </div>
                    <div class="Appointment-info">
                        <div>
